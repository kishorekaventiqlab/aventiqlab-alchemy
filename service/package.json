{
  "name": "@aventiqlab/alchemy-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "alchemy's HTTP service for the ASTRA Content Studio generation pipeline (POST /v1/generate, POST /v1/render, POST /v1/artifacts/sign). AL2 = the service foundation (auth, error envelope, health + whoami).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.all.json",
    "test": "node --import tsx --test $(find src -name '*.test.ts')",
    "mint-test-token": "tsx scripts/mint-test-token.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@fastify/aws-lambda": "^5.1.0",
    "ajv": "^8.17.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.9.6",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  }
}
