{
  "name": "@aventiqlab/alchemy-service-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CDK (TypeScript) for alchemy's Content Studio service — AL2 (request-service Lambda + Function URL) and AL7 (the content bucket).",
  "bin": {
