# Local dev config for the alchemy Content Studio service.
# Copy to .env (gitignored). Production resolves these from Secrets Manager.

# --- Required ---
# HS256 shared secret for astra -> alchemy service tokens (contract §2.3).
# Local: any string >= 32 chars. Production: resolved from Secrets Manager via
# ALCHEMY_SERVICE_JWT_SECRET_ARN instead.
ALCHEMY_SERVICE_JWT_SECRET=local-dev-secret-change-me-min-32-chars

# --- Optional (defaults shown) ---
# ALCHEMY_JWT_ISSUER=aventiqlab-astra
# ALCHEMY_JWT_AUDIENCE=aventiqlab-alchemy
# ALCHEMY_JWT_CLOCK_TOLERANCE_SEC=30
# AWS_REGION=ap-south-1
# LOG_LEVEL=info
# PORT=3000
# NODE_ENV=development

# --- AL3 /v1/generate (resolved lazily on first request) ---
# OpenRouter API key. Local: set directly. Production: OPENROUTER_API_KEY_ARN.
# A missing key surfaces as `not_configured` on the first /v1/generate call.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL_DEFAULT=anthropic/claude-sonnet-4
# OPENROUTER_MODEL_MATERIAL=...            # per-type override (optional)
# OPENROUTER_MODEL_QUIZ=...
# OPENROUTER_MODEL_SOURCE_CODE_LAB=...
# OPENROUTER_MODEL_SKILL_EVALUATOR=...
# OPENROUTER_TIMEOUT_MS=120000
# The AL7 bucket name — required for /v1/generate to persist output and for
# /v1/artifacts/sign to validate pointers.
# ALCHEMY_CONTENT_BUCKET=aventiqlab-alchemy-content

# --- AL6 /v1/artifacts/sign ---
# Presigned-URL TTL in seconds. Default 900 (15 min). Clamped to [60, 3600].
# ALCHEMY_SIGNED_URL_TTL_SEC=900

# --- Production-only (do NOT set locally) ---
# ALCHEMY_SERVICE_JWT_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:880636108741:secret:alchemy/service-secrets-XXXXXX
# ALCHEMY_SERVICE_JWT_SECRET_JSON_KEY=ALCHEMY_SERVICE_JWT_SECRET
# OPENROUTER_API_KEY_ARN=arn:aws:secretsmanager:ap-south-1:880636108741:secret:alchemy/service-secrets-XXXXXX
# OPENROUTER_API_KEY_JSON_KEY=OPENROUTER_API_KEY
