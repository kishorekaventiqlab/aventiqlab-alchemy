{
  "name": "@aventiqlab/alchemy-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Alchemy content delivery + publishing API: API Gateway REST -> Lambda (router) + Lambda authorizer.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
