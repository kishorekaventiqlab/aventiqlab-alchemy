# Copy this file to .env and fill in values for your machine. .env is
# gitignored — nothing here is committed. All paths are resolved relative to
# the video-studio/ directory if not absolute.

# ---- Chatterbox V3 (this project's sole TTS backend) ----
# See video-studio/tools/chatterbox/README.md for setup and
# docs/experiments/chatterbox-v3-tts.md for the comparison against Piper
# that led to standardizing on it (Piper has been fully removed).

# Path to the Python interpreter with chatterbox-tts installed.
# macOS/Linux: tools/chatterbox/.venv/bin/python
# Windows:     tools/chatterbox/.venv/Scripts/python.exe
CHATTERBOX_PYTHON=tools/chatterbox/.venv/bin/python

# Inference device: auto | cuda | mps | cpu. "auto" picks CUDA if available,
# else MPS (macOS), else CPU — set this only to force a specific device.
CHATTERBOX_DEVICE=auto

# Optional reference voice WAV for voice conditioning (Chatterbox's
# audio_prompt_path). See video-studio/tools/chatterbox/README.md for how to
# create voices/aventiqlab-narrator/reference.wav. Leave unset to use
# Chatterbox's built-in default voice.
# CHATTERBOX_VOICE_REF=voices/aventiqlab-narrator/reference.wav
