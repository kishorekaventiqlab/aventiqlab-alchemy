# AL5/AL9 — the one-shot Fargate render worker image.
#
# Bundles: video-studio (Node/Remotion) + headless Chromium (via
# @remotion/renderer's own download) + ffmpeg/ffprobe + a Chatterbox V3 CPU
# Python venv with weights pre-pulled at build time (AL9 — keeps the exact
# voice, zero per-use cost, offline; see docs/content-studio-al5-render-plan.md §5).
#
# Built from the video-studio/ directory (CDK:
# ContainerImage.fromAsset("../../video-studio", { file: "Dockerfile.render" })
# from service/infra/lib/render-compute.ts).
FROM node:20-bookworm AS base

# ffmpeg/ffprobe for poster extraction + duration probing; Python for Chatterbox;
# Chromium deps for Remotion's headless render.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    python3.11 python3.11-venv python3-pip \
    ca-certificates curl \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ---- Chatterbox V3 CPU venv (AL9) ----------------------------------------
COPY tools/chatterbox/requirements.txt tools/chatterbox/requirements.txt
RUN python3.11 -m venv /app/tools/chatterbox/.venv \
    && /app/tools/chatterbox/.venv/bin/pip install --no-cache-dir --upgrade pip \
    && /app/tools/chatterbox/.venv/bin/pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch torchaudio \
    && /app/tools/chatterbox/.venv/bin/pip install --no-cache-dir -r tools/chatterbox/requirements.txt

COPY tools/chatterbox/synthesize.py tools/chatterbox/synthesize.py

# Pre-pull the model weights so the first render doesn't wait on a HuggingFace
# download (AL9 plan §5). Runs a throwaway synthesis to force the download +
# cache into the image layer.
ENV HF_HOME=/app/.cache/huggingface
RUN /app/tools/chatterbox/.venv/bin/python tools/chatterbox/synthesize.py \
      --text "warm the cache" --output /tmp/warm.wav --device cpu || true

# ---- Node / video-studio -------------------------------------------------
# npm ci (not install) against a REQUIRED (non-glob) package-lock.json: `npm
# install` re-resolves within package.json's caret ranges at build time
# against whatever the registry currently has, drifting the resolved
# `remotion`/`zod` tree build to build. `npm ci` refuses to deviate from the
# lockfile (and fails fast if it's missing or out of sync with package.json),
# so the exact dependency tree that was tested is what actually ships.
#
# The lockfile itself was regenerated from a TRULY ISOLATED `npm install`
# (this repo is an npm workspace; the committed lockfile's original
# resolution depended on hoisting from the workspace root, which this Docker
# build context never has — `ContainerImage.fromAsset("../../video-studio")`
# copies video-studio/ alone) — without that, `npm ci` fails outright here
# even though it succeeds when run from inside the workspace.
#
# The actual real-render blocker this whole investigation was chasing turned
# out to be separate from the dependency drift: Remotion's default webpack
# config never resolves this codebase's `.js`-suffixed TS-ESM imports (e.g.
# `from '../compositions/SpecVideo.js'`) to their real `.tsx` source, no
# matter which dependency versions are installed — fixed via
# resolve.extensionAlias in remotion.config.ts, not here.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .

ENV CHATTERBOX_PYTHON=/app/tools/chatterbox/.venv/bin/python
ENV CHATTERBOX_DEVICE=cpu
ENV NODE_ENV=production

# Remotion needs its own Chromium; this pre-downloads it into the image so a
# render doesn't pay for it.
RUN npx remotion browser ensure || true

CMD ["npx", "tsx", "src/render/worker.ts"]
