{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability.schema.json",
  "title": "Capability",
  "description": "A capability within a domain. Hierarchy: Domain -> Capability -> Skill -> Evidence. Each capability holds a small set of verb-tagged skills, and each skill carries concrete, observable evidence that proves it. Tier indicators are holistic narrative summaries of what a learner at that tier looks like overall, distinct from the granular per-skill statements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "domain", "description", "skills", "common_tools",
    "beginner_indicators", "intermediate_indicators", "advanced_indicators", "expert_architect_indicators"
  ],
  "properties": {
    "id": { "$ref": "./common/vocab.schema.json#/$defs/cap_id" },
    "name": { "type": "string" },
    "domain": { "$ref": "./common/vocab.schema.json#/$defs/domain_slug" },
    "description": { "type": "string" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "verb", "statement", "evidence"],
        "properties": {
          "id": { "$ref": "./common/vocab.schema.json#/$defs/skl_id" },
          "name": { "type": "string" },
          "verb": { "$ref": "./common/vocab.schema.json#/$defs/capability_verb" },
          "statement": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    },
    "common_tools": { "type": "array", "items": { "type": "string" } },
    "beginner_indicators": { "type": "array", "items": { "type": "string" } },
    "intermediate_indicators": { "type": "array", "items": { "type": "string" } },
    "advanced_indicators": { "type": "array", "items": { "type": "string" } },
    "expert_architect_indicators": { "type": "array", "items": { "type": "string" } }
  }
}
